@model JobApplication
@{ ViewData["Title"] = "Edit application"; }

<div class="card form-card">
    <h1>Edit application</h1>
    <form asp-action="Edit" asp-route-id="@Model.AppID" method="post">
        <input type="hidden" asp-for="AppID" />
        <partial name="_Form" model="Model" />
        <div class="buttons">
            <button type="submit" class="btn">Save changes</button>
            <a class="btn light" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
