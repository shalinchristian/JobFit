@model RegisterModel
@{ ViewData["Title"] = "Register"; }

<div class="card narrow">
    <h1>Create an account</h1>
    <form asp-action="Register" method="post">
        <div asp-validation-summary="ModelOnly" class="error"></div>

        <label asp-for="Username"></label>
        <input asp-for="Username" />
        <span asp-validation-for="Username" class="error"></span>

        <label asp-for="Email"></label>
        <input asp-for="Email" />
        <span asp-validation-for="Email" class="error"></span>

        <label asp-for="Password"></label>
        <input asp-for="Password" />
        <span asp-validation-for="Password" class="error"></span>

        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" />
        <span asp-validation-for="ConfirmPassword" class="error"></span>

        <button type="submit" class="btn">Register</button>
    </form>
    <p class="muted">Already have an account? <a asp-action="Login">Log in</a></p>
</div>
