@model LoginModel
@{ ViewData["Title"] = "Login"; }

<div class="card narrow">
    <h1>Log in</h1>
    <form asp-action="Login" method="post">
        <div asp-validation-summary="ModelOnly" class="error"></div>

        <label asp-for="Username"></label>
        <input asp-for="Username" />
        <span asp-validation-for="Username" class="error"></span>

        <label asp-for="Password"></label>
        <input asp-for="Password" />
        <span asp-validation-for="Password" class="error"></span>

        <button type="submit" class="btn">Log in</button>
    </form>
    <p class="muted">New here? <a asp-action="Register">Create an account</a></p>
</div>
