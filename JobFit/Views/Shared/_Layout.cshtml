@{
    string? username = Context.Session.GetString("Username");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - JobFit</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="navbar">
        <div class="container nav-inner">
            <a class="brand" asp-controller="Applications" asp-action="Index">
                <img src="~/img/logo.svg" alt="" width="26" height="26" /> JobFit
            </a>
            <nav>
                @if (username != null)
                {
                    <span class="hello">Hi, @username</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                        <button type="submit" class="link-button">Logout</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login">Login</a>
                    <a asp-controller="Account" asp-action="Register">Register</a>
                }
            </nav>
        </div>
    </header>

    <main class="container">
        @if (TempData["Message"] != null)
        {
            <p class="alert">@TempData["Message"]</p>
        }
        @RenderBody()
    </main>

    <footer class="container footer">JobFit - a simple job application tracker</footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
