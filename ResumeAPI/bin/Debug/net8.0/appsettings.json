{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // URL of the Python similarity microservice
  // Change this if you run the Python service on a different port or machine
  "PythonService": {
    "BaseUrl": "http://localhost:5001"
  },

  // Optional: PostgreSQL connection string (unused when using in-memory DB)
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=resumedb;Username=postgres;Password=yourpassword"
  }
}
