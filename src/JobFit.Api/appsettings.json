{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": { "Provider": "Sqlite" },
  "Demo": { "Seed": false },

  // URL of the Python similarity microservice
  // Change this if you run the Python service on a different port or machine
  "PythonService": {
    "BaseUrl": "http://localhost:5001"
  },

  // SQLite file for the job tracker. Set Database:Provider to "InMemory" to keep nothing on disk.
  "ConnectionStrings": {
    "JobFit": "Data Source=jobfit.db"
  }
}
