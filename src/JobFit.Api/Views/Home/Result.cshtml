@model FitResultViewModel
@{
    ViewData["Title"] = "Fit check · " + Model.JobTitle;
    ViewData["Nav"] = "check";
}
<div class="page-head">
    <a class="back" href="/">← New check</a>
    <form method="post" action="/Home/Save" class="inline">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Title" value="@Model.JobTitle" />
        <input type="hidden" name="Company" value="@Model.Company" />
        <input type="hidden" name="Score" value="@Model.Score.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
        <input type="hidden" name="Label" value="@Model.Label" />
        <input type="hidden" name="UsedFallback" value="@Model.UsedFallback.ToString().ToLowerInvariant()" />
        <input type="hidden" name="JobDescription" value="@Model.JobDescription" />
        <input type="hidden" name="MatchedSkillsText" value="@string.Join("\n", Model.Matched)" />
        <input type="hidden" name="MissingSkillsText" value="@string.Join("\n", Model.Missing)" />
        <input type="hidden" name="ResumeSkillsText" value="@string.Join("\n", Model.ResumeSkills)" />
        <button class="btn btn-primary" type="submit">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
            <span>Save to tracker</span>
        </button>
    </form>
</div>
<partial name="_FitResult" model="Model" />
